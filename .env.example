# Copy to .env and fill in. Never commit .env. Mode 600.

# OCR (Phase 2)
GEMINI_API_KEY=

# Sheets log (Phase 6, optional)
GOOGLE_SHEET_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Webhook auth (Phase 5)
WEBHOOK_SECRET=

# Dashboard password (Phase 4). Store a bcrypt-free SHA-256 hash, see README.
UI_PASSWORD_SHA256=

# Owner field encryption key (Phase 4). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OWNER_DB_KEY=

# Alerts (Phase 7)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
